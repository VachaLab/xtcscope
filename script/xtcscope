#!/usr/bin/env -S uv run --quiet --script

"""
View the last frames of a running GROMACS job.

The last frames of the job's XTC are copied by xtcscope-agent on the compute
node, through a single SSH connection, into a temporary file on this machine,
and opened in a viewer (VMD 1.9, VMD 2, ViaMD, or any program that accepts
`<command> <gro> <xtc>`).

Requires `uv`: https://docs.astral.sh/uv
"""

# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "qq",
# ]
#
# [tool.uv.sources]
# qq = { git = "https://github.com/VachaLab/qq.git", tag = "v0.13.0" }
# ///

import argparse
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable, Sequence
from dataclasses import dataclass
from pathlib import Path

# Replaced with the release version by the release workflow.
__version__ = "__VERSION__"

# Frames fetched when -n is not given.
DEFAULT_FRAMES = 10
# Viewer used when neither --viewer nor XTCSCOPE_VIEWER is set.
DEFAULT_VIEWER = "vmd"
# The agent on the node; $HOME is expanded by the remote shell.
AGENT = '"$HOME/xtcscope/xtcscope-agent"'
# XTC magic numbers the agent understands.
XTC_MAGICS = (1995, 2023)
# Exit status of ssh itself when the connection fails.
SSH_FAILED = 255
# Exit status of the remote shell (or nice) when a command does not exist.
COMMAND_NOT_FOUND = 127

# Exit codes (see the specification).
EXIT_OK = 0
EXIT_BUG = 1
EXIT_USAGE = 2
EXIT_NO_JOB = 3
EXIT_NO_WORK_DIR = 4
EXIT_NO_FILE = 5
EXIT_MISMATCH = 6
EXIT_SSH = 7
EXIT_AGENT = 8
EXIT_VIEWER = 9
EXIT_INTERRUPTED = 130

# Set by --debug.
DEBUG = False


class XtcscopeError(Exception):
    """An expected failure: printed as one ERROR line, exits with `exit_code`."""

    def __init__(self, message: str, exit_code: int):
        """Create an error with its message and exit code."""
        super().__init__(message)
        self.exit_code = exit_code


def version_string() -> str:
    """Return the version for display; unreleased copies say so."""
    if __version__.startswith("__"):
        return "development version"
    return __version__


def info(message: str) -> None:
    """Print an INFO line on stderr."""
    print(f"INFO    {message}", file=sys.stderr)


def warn(message: str) -> None:
    """Print a WARN line on stderr."""
    print(f"WARN    {message}", file=sys.stderr)


def error(message: str) -> None:
    """Print an ERROR line on stderr."""
    print(f"ERROR   {message}", file=sys.stderr)


def debug(message: str) -> None:
    """Print a DEBUG line on stderr when --debug is given."""
    if DEBUG:
        print(f"DEBUG   {message}", file=sys.stderr)


# --- files -----------------------------------------------------------------------------


@dataclass(frozen=True)
class Candidate:
    """A GRO or XTC file that could be chosen."""

    name: str
    size: int
    mtime: float
    natoms: int | None
    # Why the file can't be chosen, or None if it can.
    problem: str | None = None


def read_gro_atom_count(path: Path) -> int:
    """Return the atom count from line 2 of a GRO file."""
    try:
        with path.open() as handle:
            handle.readline()
            line = handle.readline()
    except OSError as err:
        raise XtcscopeError(f"Could not read '{path}': {err.strerror}.", EXIT_MISMATCH) from err
    try:
        return int(line.split()[0])
    except (IndexError, ValueError) as err:
        raise XtcscopeError(
            f"'{path}' is not a valid GRO file: line 2 does not hold an atom count.",
            EXIT_MISMATCH,
        ) from err


def list_gro_files(directory: Path) -> list[Candidate]:
    """List the GRO files in a local directory, newest first."""
    candidates = []
    for path in directory.glob("*.gro"):
        if not path.is_file():
            continue
        stat = path.stat()
        try:
            natoms, problem = read_gro_atom_count(path), None
        except XtcscopeError:
            natoms, problem = None, "not a valid GRO file"
        candidates.append(Candidate(path.name, stat.st_size, stat.st_mtime, natoms, problem))
    return sorted(candidates, key=lambda c: c.mtime, reverse=True)


def xtc_listing_command(work_dir: Path) -> str:
    """Shell command that prints name, size, mtime and the first 8 bytes of each XTC."""
    return (
        f"cd -- {shlex.quote(str(work_dir))} && "
        'for f in *.xtc; do [ -f "$f" ] || continue; '
        "printf '%s\\t%s\\t%s\\t%s\\n' \"$f\" "
        '"$(stat -c %s -- "$f")" "$(stat -c %Y -- "$f")" '
        '"$(od -An -v -tx1 -N8 -- "$f" | tr -d \' \\n\')"; done'
    )


def parse_xtc_listing(text: str) -> list[Candidate]:
    """Parse the output of `xtc_listing_command`, newest first."""
    candidates = []
    for line in text.splitlines():
        parts = line.split("\t")
        if len(parts) != 4:
            continue
        name, size, mtime, head = parts
        natoms, problem = None, None
        if len(head) < 16:
            problem = "empty"
        else:
            magic = int(head[0:8], 16)
            if magic not in XTC_MAGICS:
                problem = "not an XTC file"
            else:
                natoms = int(head[8:16], 16)
        candidates.append(Candidate(name, int(size), float(mtime), natoms, problem))
    return sorted(candidates, key=lambda c: c.mtime, reverse=True)


def format_ps(time_ps: float) -> str:
    """Format a time in ps without single-precision noise, e.g. 700.00006 -> 700."""
    return f"{time_ps:.3f}".rstrip("0").rstrip(".")


def human_size(size: int) -> str:
    """Format a byte count, e.g. 1.5 MB."""
    value = float(size)
    for unit in ("B", "kB", "MB", "GB"):
        if value < 1000 or unit == "GB":
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1000
    return f"{value:.1f} TB"


# Picks a candidate interactively: (kind, candidates) -> index into candidates.
Ask = Callable[[str, Sequence[Candidate]], int]


def ask_with_rich(kind: str, candidates: Sequence[Candidate]) -> int:
    """Show the candidates in a table and ask for one; returns its index."""
    # Imported here so that the pure helpers and their tests need no third-party packages.
    from datetime import datetime

    from rich.console import Console
    from rich.prompt import Prompt
    from rich.table import Table

    console = Console(stderr=True)
    table = Table(title=f"{kind} files", title_justify="left")
    for column in ("#", "name", "size", "modified", "atoms"):
        table.add_column(column)
    for i, c in enumerate(candidates, start=1):
        modified = datetime.fromtimestamp(c.mtime).strftime("%Y-%m-%d %H:%M")
        table.add_row(str(i), c.name, human_size(c.size), modified, str(c.natoms))
    console.print(table)
    choices = [str(i) for i in range(1, len(candidates) + 1)]
    answer = Prompt.ask(f"Select the {kind} file", choices=choices, default="1", console=console)
    return int(answer) - 1


def choose(
    kind: str,
    where: str,
    candidates: Sequence[Candidate],
    requested: str | None,
    ask: Ask | None,
) -> Candidate:
    """Pick a file: the requested one, the only one, or one the user chooses.

    `ask` is None when the user can't be asked (stdin is not a terminal).
    """
    usable = [c for c in candidates if c.problem is None]
    for c in candidates:
        if c.problem is not None and c.name != requested:
            warn(f"Ignoring {c.name} in {where}: {c.problem}.")
    if requested is not None:
        for c in candidates:
            if c.name == requested:
                if c.problem is not None:
                    raise XtcscopeError(f"{requested} in {where}: {c.problem}.", EXIT_NO_FILE)
                return c
        raise XtcscopeError(f"There is no {requested} in {where}.", EXIT_NO_FILE)
    if not usable:
        raise XtcscopeError(f"No usable {kind} file in {where}.", EXIT_NO_FILE)
    if len(usable) == 1:
        info(f"Using {usable[0].name}")
        return usable[0]
    if ask is None:
        option = f"--{kind.lower()}"
        raise XtcscopeError(
            f"Several {kind} files in {where}; choose one with {option} NAME.", EXIT_NO_FILE
        )
    return usable[ask(kind, usable)]


# --- viewer ----------------------------------------------------------------------------


def viewer_words(viewer: str) -> list[str]:
    """Split the viewer command (e.g. "vmd -nt") and check that it can be run."""
    words = shlex.split(viewer)
    if not words:
        raise XtcscopeError("The viewer command is empty.", EXIT_VIEWER)
    if shutil.which(words[0]) is None:
        raise XtcscopeError(
            f"Viewer '{words[0]}' was not found; set it with --viewer or XTCSCOPE_VIEWER.",
            EXIT_VIEWER,
        )
    return words


def viewer_argv(words: Sequence[str], gro: Path, xtc: Path) -> list[str]:
    """The command that opens a GRO and an XTC: `<viewer> <gro> <xtc>`."""
    return [*words, str(gro), str(xtc)]


# --- SSH -------------------------------------------------------------------------------


def ssh_options(timeout: int) -> list[str]:
    """Options for the master connection, as qq uses them, plus keep-alives."""
    return [
        "-o",
        "PasswordAuthentication=no",
        "-o",
        "GSSAPIAuthentication=yes",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        f"ConnectTimeout={timeout}",
        "-o",
        "ServerAliveInterval=15",
    ]


class Remote:
    """One SSH master connection to a node, reused by every remote command."""

    def __init__(self, node: str, tmp_dir: Path, timeout: int):
        """Prepare a connection to `node`; its control socket lives in `tmp_dir`."""
        self.node = node
        self.control = tmp_dir / "ctl"
        self.timeout = timeout
        self.is_open = False

    def open(self) -> None:
        """Open the master connection; one authentication for the whole run."""
        command = [
            "ssh",
            *ssh_options(self.timeout),
            "-M",
            "-S",
            str(self.control),
            "-f",
            "-N",
            self.node,
        ]
        debug(f"$ {shlex.join(command)}")
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()
            reason = f": {detail[-1]}" if detail else ""
            raise XtcscopeError(f"Could not connect to {self.node}{reason}", EXIT_SSH)
        self.is_open = True

    def command(self, remote_command: str) -> list[str]:
        """The local command that runs `remote_command` over the master connection."""
        return ["ssh", "-S", str(self.control), self.node, remote_command]

    def run(self, remote_command: str) -> subprocess.CompletedProcess:
        """Run a remote command and capture its output as text."""
        command = self.command(remote_command)
        debug(f"$ {shlex.join(command)}")
        return subprocess.run(command, capture_output=True, text=True)

    def close(self) -> None:
        """Close the master connection; errors are ignored."""
        if not self.is_open:
            return
        command = ["ssh", "-S", str(self.control), "-O", "exit", self.node]
        debug(f"$ {shlex.join(command)}")
        subprocess.run(command, capture_output=True)
        self.is_open = False

    def __enter__(self) -> "Remote":
        """Open the connection."""
        self.open()
        return self

    def __exit__(self, *exc) -> None:
        """Close the connection."""
        self.close()


def list_xtc_files(remote: Remote, work_dir: Path) -> list[Candidate]:
    """List the XTC files in the job's working directory on the node."""
    result = remote.run(xtc_listing_command(work_dir))
    if result.returncode == SSH_FAILED:
        raise XtcscopeError(
            f"Lost the connection to {remote.node}: {result.stderr.strip()}", EXIT_SSH
        )
    if result.returncode != 0:
        raise XtcscopeError(
            f"Working directory {work_dir} is not accessible on {remote.node}.",
            EXIT_NO_WORK_DIR,
        )
    return parse_xtc_listing(result.stdout)


def extract_command(xtc: Path, frames: int) -> str:
    """Remote command that writes the last `frames` frames of `xtc` to stdout."""
    return f"nice -n 19 ionice -c3 {AGENT} extract --xtc {shlex.quote(str(xtc))} --frames {frames}"


def extracted_name(xtc_name: str, frames: int) -> str:
    """Local file name for the extracted frames, e.g. md.last10.xtc."""
    stem = xtc_name[:-4] if xtc_name.endswith(".xtc") else xtc_name
    return f"{stem}.last{frames}.xtc"


@dataclass(frozen=True)
class Fetched:
    """What the agent reported about the frames it copied."""

    frames: int
    first_time_ps: float
    last_time_ps: float
    bytes: int


def parse_event(line: str) -> dict | None:
    """Parse one stderr line of the agent; None if it is not an agent event."""
    try:
        event = json.loads(line)
    except ValueError:
        return None
    if isinstance(event, dict) and isinstance(event.get("event"), str):
        return event
    return None


def fetch_frames(remote: Remote, xtc: Path, frames: int, destination: Path) -> Fetched:
    """Run the agent over the master connection, saving its stdout to `destination`.

    Warnings are shown as they arrive. The result is checked: the agent must
    exit 0, report `located` and `done`, and the file must have exactly the
    size both events report.
    """
    command = remote.command(extract_command(xtc, frames))
    debug(f"$ {shlex.join(command)} > {destination}")
    located = done = failure = None
    other_lines: list[str] = []
    started = time.monotonic()
    with destination.open("wb") as out:
        process = subprocess.Popen(command, stdout=out, stderr=subprocess.PIPE, text=True)
        try:
            for line in process.stderr:
                event = parse_event(line)
                if event is None:
                    other_lines.append(line.rstrip("\n"))
                    debug(f"remote: {line.rstrip()}")
                    continue
                debug(f"agent: {line.rstrip()}")
                kind = event["event"]
                if kind == "warning":
                    warn(f"{event.get('message')} ({event.get('code')})")
                elif kind == "located":
                    located = event
                    first = format_ps(event["first_time_ps"])
                    last = format_ps(event["last_time_ps"])
                    size = human_size(event["bytes"])
                    info(
                        f"Fetching {event['frames']} frames "
                        f"({first}\u2013{last} ps, {size}) from {xtc.name}"
                    )
                elif kind == "done":
                    done = event
                elif kind == "error":
                    failure = event
            code = process.wait()
        except BaseException:
            # Ctrl-C or SIGTERM: closing SSH makes the agent exit on its next write.
            process.terminate()
            process.wait()
            raise
    size = destination.stat().st_size

    if failure is not None:
        raise XtcscopeError(
            f"The agent on {remote.node} failed: {failure.get('message')} ({failure.get('code')})",
            EXIT_AGENT,
        )
    if code == COMMAND_NOT_FOUND and any("xtcscope-agent" in line for line in other_lines):
        raise XtcscopeError(
            f"xtcscope-agent is not installed on {remote.node}; run the installer.", EXIT_AGENT
        )
    if code == SSH_FAILED:
        raise XtcscopeError(f"Lost the connection to {remote.node}.", EXIT_SSH)
    if code != 0:
        detail = "; ".join(other_lines[-3:]) or "no message"
        raise XtcscopeError(f"The agent on {remote.node} exited with {code}: {detail}", EXIT_AGENT)
    if located is None or done is None:
        raise XtcscopeError(f"The agent on {remote.node} did not report its work.", EXIT_AGENT)
    if not (size == located["bytes"] == done["bytes"]):
        raise XtcscopeError(
            f"The fetched file is incomplete: {size} bytes, expected {located['bytes']}.",
            EXIT_AGENT,
        )
    debug(f"fetched {size} bytes in {time.monotonic() - started:.2f} s")
    return Fetched(
        frames=located["frames"],
        first_time_ps=located["first_time_ps"],
        last_time_ps=located["last_time_ps"],
        bytes=size,
    )


def launch_viewer(argv: Sequence[str]) -> None:
    """Run the viewer and wait until it exits; a non-zero exit is only a warning."""
    debug(f"$ {shlex.join(argv)}")
    try:
        result = subprocess.run(argv)
    except OSError as err:
        raise XtcscopeError(f"Could not start the viewer '{argv[0]}': {err}", EXIT_VIEWER) from err
    if result.returncode != 0:
        warn(f"The viewer exited with code {result.returncode}.")


# --- the job (qq) ----------------------------------------------------------------------


@dataclass(frozen=True)
class Job:
    """What xtcscope needs to know about a qq job."""

    job_id: str
    name: str
    node: str
    work_dir: Path
    input_dir: Path


def find_job(job_id: str | None) -> Job:
    """Resolve the job (by ID, or the newest one in the current directory) via qq."""
    # Imported here so that the pure helpers and their tests need no qq.
    from qq_lib.core.common import get_info_files
    from qq_lib.core.navigator import Navigator
    from qq_lib.info import Informer

    try:
        if job_id is not None:
            informer = Informer.from_job_id(job_id)
        else:
            files = get_info_files(Path())
            if not files:
                raise XtcscopeError("No job detected in the current directory.", EXIT_NO_JOB)
            informer = Informer.from_file(files[-1])
    except XtcscopeError:
        raise
    except Exception as err:
        raise XtcscopeError(f"Could not find job '{job_id}': {err}", EXIT_NO_JOB) from err

    found_id = informer.info.job_id
    navigator = Navigator.from_informer(informer)
    if not navigator.has_destination():
        raise XtcscopeError(f"Job {found_id} does not have a working directory.", EXIT_NO_WORK_DIR)
    return Job(
        job_id=found_id,
        name=informer.info.job_name,
        node=navigator.get_main_node(),
        work_dir=Path(navigator.get_work_dir()),
        input_dir=Path(informer.info.input_dir),
    )


def ssh_timeout() -> int:
    """qq's SSH timeout in seconds."""
    from qq_lib.core.config import CFG

    return CFG.timeouts.ssh


# --- command line ----------------------------------------------------------------------


def frames_count(value: str) -> int:
    """argparse type for -n: an integer of at least 1."""
    try:
        number = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid number of frames: '{value}'") from None
    if number < 1:
        raise argparse.ArgumentTypeError("the number of frames must be at least 1")
    return number


def file_name(suffix: str) -> Callable[[str], str]:
    """argparse type for --gro/--xtc: a bare file name with the given suffix."""

    def check(value: str) -> str:
        """Reject paths and wrong suffixes."""
        if "/" in value:
            raise argparse.ArgumentTypeError(f"give a file name, not a path: '{value}'")
        if not value.endswith(suffix):
            raise argparse.ArgumentTypeError(f"'{value}' does not end in {suffix}")
        return value

    return check


def build_parser() -> argparse.ArgumentParser:
    """Build the command-line parser."""
    parser = argparse.ArgumentParser(
        prog="xtcscope",
        description="View the last frames of a running GROMACS job.",
    )
    parser.add_argument(
        "job_id",
        nargs="?",
        help="Job ID. Default: the newest qq job in the current directory.",
    )
    parser.add_argument(
        "--viewer",
        default=os.environ.get("XTCSCOPE_VIEWER", DEFAULT_VIEWER),
        help=(
            "Command that opens '<gro> <xtc>', e.g. vmd, vmd2, viamd or 'vmd -nt'. "
            f"Default: $XTCSCOPE_VIEWER, or {DEFAULT_VIEWER}."
        ),
    )
    parser.add_argument(
        "--gro",
        type=file_name(".gro"),
        metavar="NAME",
        help="GRO file in the job's input directory. Default: the only one, or ask.",
    )
    parser.add_argument(
        "--xtc",
        type=file_name(".xtc"),
        metavar="NAME",
        help="XTC file in the job's working directory. Default: the only one, or ask.",
    )
    parser.add_argument(
        "-n",
        "--frames",
        type=frames_count,
        default=DEFAULT_FRAMES,
        metavar="N",
        help=f"Number of frames from the end of the XTC. Default: {DEFAULT_FRAMES}.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Choose the files and check them, then print the commands instead of running them.",
    )
    parser.add_argument(
        "--debug", action="store_true", help="Print every command and every agent event."
    )
    parser.add_argument("--version", action="version", version=f"xtcscope {version_string()}")
    return parser


def run(args: argparse.Namespace) -> int:
    """Run xtcscope with parsed arguments; returns the exit code."""
    words = viewer_words(args.viewer)

    # 1-2. The job and its working directory.
    job = find_job(args.job_id)
    info(f"Job {job.job_id} ({job.name}) runs on {job.node} in {job.work_dir}")

    # 4. The GRO, read locally from the input directory (no fallback).
    if not job.input_dir.is_dir():
        raise XtcscopeError(
            f"Input directory {job.input_dir} is not accessible from this machine.",
            EXIT_NO_FILE,
        )
    ask = ask_with_rich if sys.stdin.isatty() else None
    gro = choose("GRO", str(job.input_dir), list_gro_files(job.input_dir), args.gro, ask)
    gro_path = job.input_dir / gro.name

    tmp_dir = Path(tempfile.mkdtemp(prefix="xtcscope-"))
    try:
        # 3. One SSH connection for everything on the node.
        with Remote(job.node, tmp_dir, ssh_timeout()) as remote:
            # 5-6. The XTC, listed on the node.
            xtc_files = list_xtc_files(remote, job.work_dir)
            xtc = choose("XTC", f"{job.node}:{job.work_dir}", xtc_files, args.xtc, ask)
            xtc_path = job.work_dir / xtc.name

            # 7. Both files must describe the same atoms.
            if gro.natoms != xtc.natoms:
                raise XtcscopeError(
                    f"{gro.name} has {gro.natoms} atoms but {xtc.name} has {xtc.natoms}; "
                    "if the job writes only some atoms (compressed-x-grps), "
                    "its input directory needs a GRO with the same atoms.",
                    EXIT_MISMATCH,
                )

            local_xtc = tmp_dir / extracted_name(xtc.name, args.frames)
            fetch = shlex.join(remote.command(extract_command(xtc_path, args.frames)))
            view = shlex.join(viewer_argv(words, gro_path, local_xtc))
            if args.dry_run:
                print(f"job      {job.job_id} ({job.name})")
                print(f"node     {job.node}")
                print(f"gro      {gro_path} ({gro.natoms} atoms)")
                print(f"xtc      {xtc_path} ({xtc.natoms} atoms)")
                print(f"extract  {fetch} > {local_xtc}")
                print(f"view     {view}")
                return EXIT_OK

            # 8. Copy the last frames into the temporary directory.
            fetch_frames(remote, xtc_path, args.frames, local_xtc)
        # 9. The connection is closed here; nothing else needs the node.

        # 10. Open the files and wait for the viewer to exit.
        info(f"Opening {gro.name} and {local_xtc.name} in {words[0]}")
        launch_viewer(viewer_argv(words, gro_path, local_xtc))
        return EXIT_OK
    finally:
        # 11. Remove the control socket and the fetched frames.
        shutil.rmtree(tmp_dir, ignore_errors=True)


def raise_interrupt(signum, frame) -> None:
    """Turn SIGTERM into KeyboardInterrupt, so it takes the Ctrl-C path."""
    raise KeyboardInterrupt


def main(argv: list[str] | None = None) -> int:
    """Entry point. Returns the process exit code."""
    global DEBUG
    args = build_parser().parse_args(argv)
    DEBUG = args.debug
    previous = signal.signal(signal.SIGTERM, raise_interrupt)
    try:
        return run(args)
    except XtcscopeError as err:
        error(str(err))
        return err.exit_code
    except KeyboardInterrupt:
        error("Interrupted.")
        return EXIT_INTERRUPTED
    finally:
        signal.signal(signal.SIGTERM, previous)


if __name__ == "__main__":
    sys.exit(main())
